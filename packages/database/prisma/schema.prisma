generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ==========================================
// 1. UTILISATEURS, SESSIONS & RBAC
// ==========================================

enum SpaceType {
  CUSTOMER
  DISTRIBUTOR
  COURIER
  ACCOUNT_MANAGER
  STAFF
}

model User {
  id              String           @id @default(uuid())
  spaceType       SpaceType        @default(CUSTOMER) @map("space_type")
  phone           String           @unique
  whatsappPhone   String?          @unique @map("whatsapp_e164")
  callPhone       String?          @map("secondary_e164")
  whatsappVerifiedAt DateTime?     @map("whatsapp_verified_at")
  email           String?          @unique
  passwordHash    String?          @map("password_hash") // Argon2id hash
  isPhoneVerified Boolean          @default(false)
  isEmailVerified Boolean          @default(false)
  failedAttempts  Int              @default(0)
  failedLoginCount Int             @default(0) @map("failed_login_count")
  lockedUntil     DateTime?        @map("locked_until")
  status          String           @default("ACTIVE") // ACTIVE, LOCKED, SUSPENDED, PENDING_VERIFICATION

  roles           UserRole[]
  customerProfile CustomerProfile?
  distributorApp  DistributorApplication?
  courierProfile  Courier?
  staffProfile    StaffProfile?
  stores          Store[]
  sessions        Session[]
  auditLogs       AuditLog[]       @relation("UserAuditLogs")
  demandAlerts    DemandAlert[]
  recoveryCodes   RecoveryCode[]
  deviceFingerprints DeviceFingerprint[]
  staffInvitationsCreated StaffInvitation[] @relation("StaffInvitationsCreated")
  favorites       Favorite[]
  stockAlerts     StockAlert[]
  announcementReceipts AnnouncementReceipt[]

  // CR-002: Imports et Revendications Réseau
  storeClaimsSubmitted  StoreClaim[]     @relation("ClaimSubmittedBy")
  storeClaimsReviewed   StoreClaim[]     @relation("ClaimReviewedBy")
  importBatchesCreated  ImportBatch[]    @relation("ImportBatchCreatedBy")
  importBatchesApproved ImportBatch[]    @relation("ImportBatchApprovedBy")

  // CR-003 : Nouveaux flux authentifiés et assistés
  verificationChallenges VerificationChallenge[]
  managedCases           AccountCase[]           @relation("ManagedAccountCases")
  subjectCases           AccountCase[]           @relation("SubjectAccountCases")
  counterSalesAsCustomer CounterSale[]           @relation("CounterSaleCustomer")
  infoNoticeReads        InfoNoticeRead[]

  // Commandes & Livraisons
  customerOrders  Order[]          @relation("CustomerOrders")
  assistedOrders  Order[]          @relation("AssistedOrders")

  // D-01: Prix Catalogue
  createdPrices   ProductPrice[]   @relation("PriceCreatedBy")
  approvedPrices  ProductPrice[]   @relation("PriceApprovedBy")
  priceHistoriesChanged PriceHistory[] @relation("PriceHistoryChangedBy")

  // D-05: Barèmes & Gestion Livreur
  createdFees     FeeSchedule[]    @relation("FeeCreatedBy")
  approvedFees    FeeSchedule[]    @relation("FeeApprovedBy")
  cashReconciled  CashCollection[] @relation("CashReconciledBy")

  // D-06: Finances & Grand Livre
  createdPayouts  PayoutBatch[]    @relation("PayoutCreatedBy")
  approvedPayouts PayoutBatch[]    @relation("PayoutApprovedBy")
  secondApprovedPayouts PayoutBatch[] @relation("PayoutSecondApprovedBy")
  createdCreditNotes CreditNote[]  @relation("CreditNoteCreatedBy")
  ledgerEntriesCreated LedgerEntry[] @relation("LedgerEntryCreatedBy")

  // Notifications, Rapports, Chat & Support
  notifications   Notification[]
  reports         Report[]
  sentMessages    ChatMessage[]    @relation("SentMessages")
  aiChatSessions  AiChatSession[]
  aiUsageMetrics  AiUsageMetric[]
  loyaltyPoints   Int              @default(0)
  loyaltyTx       LoyaltyTransaction[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // CUSTOMER, DISTRIBUTOR, COURIER, LOGISTICS_MANAGER, FINANCE_MANAGER, SUPPORT_AGENT, CONTENT_MANAGER, ADMIN, SUPER_ADMIN
  description String?
  permissions RolePermission[]
  users       UserRole[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // e.g. "orders:read", "price:approve", "payout:create"
  description String?
  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model CustomerProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  firstName     String?
  lastName      String?
  loyaltyPoints Int       @default(100)
  addresses     Address[]

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id                String          @id @default(uuid())
  customerProfileId String
  city              String
  neighborhood      String
  landmark          String?         // Repère textuel (ex: "face pharmacie")
  latitude          Float?
  longitude         Float?
  isDefault         Boolean         @default(false)

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model StaffProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole  String   @map("staff_role") // ADMIN, SUPER_ADMIN, ACCOUNT_MANAGER, SUPPORT_AGENT
  department String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("staff_profiles")
}

model Session {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  refreshToken        String             @unique @map("refresh_token") // Hash of the refresh token
  audience            String             @default("BUYER") // BUYER, DISTRIBUTOR, COURIER, STAFF
  rotationFamily      String?            @map("rotation_family")
  deviceFingerprintId String?            @map("device_fingerprint_id")
  deviceFingerprint   DeviceFingerprint? @relation(fields: [deviceFingerprintId], references: [id])
  userAgent           String?            @map("user_agent")
  ipAddress           String?            @map("ip_address")
  expiresAt           DateTime           @map("expires_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime           @default(now()) @map("created_at")

  @@map("sessions")
}

model DeviceFingerprint {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash       String    @unique
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  isTrusted  Boolean   @default(false) @map("is_trusted")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  sessions   Session[]

  @@map("device_fingerprints")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("recovery_codes")
}

model StaffInvitation {
  id          String    @id @default(uuid())
  email       String    @unique
  staffRole   String    @map("staff_role") // ADMIN, ACCOUNT_MANAGER, etc.
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  invitedBy   User      @relation("StaffInvitationsCreated", fields: [invitedById], references: [id])
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("staff_invitations")
}

model Setting {
  id               String   @id @default("singleton")
  buyerBottleLimit Int      @default(5) @map("buyer_bottle_limit")
  supportPhone     String   @default("+237 657696567") @map("support_phone")
  supportEmail     String   @default("support@pleingaz.cm") @map("support_email")
  updatedAt        DateTime @updatedAt @map("updated_at")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
}

// ==========================================
// 2. DISTRIBUTEURS & KYC (D-04: 3 DOCUMENTS)
// ==========================================

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// D-04: Strictement 3 documents (CNI recto/verso, photo portrait, photo lieu)
enum DocumentType {
  ID_CARD_FRONT
  ID_CARD_BACK
  PORTRAIT_PHOTO
  SHOP_PHOTO
}

model DistributorApplication {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(DRAFT)
  currentStep     Int               @default(1)

  businessName    String?
  city            String?
  neighborhood    String?
  landmark        String?
  latitude        Float?
  longitude       Float?
  whatsappNumber  String?

  documents       StoreDocument[]

  rejectionReason String?
  verifiedAt      DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store           Store?
}

model StoreDocument {
  id             String                 @id @default(uuid())
  applicationId  String
  application    DistributorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           DocumentType
  fileUrl        String                 // S3 bucket privé (ou public post-approbation pour SHOP_PHOTO)
  isValid        Boolean?
  rejectedReason String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

enum VerificationLevel {
  LISTED
  CLAIMED_PENDING
  BASIC_VERIFIED
  FULLY_VERIFIED
}

enum ClaimStatus {
  UNCLAIMED
  PENDING_VERIFICATION
  CLAIMED
  REJECTED
}

model Store {
  id              String                  @id @default(uuid())
  applicationId   String?                 @unique
  application     DistributorApplication? @relation(fields: [applicationId], references: [id])
  ownerId         String?
  owner           User?                   @relation(fields: [ownerId], references: [id])

  name            String
  city            String
  neighborhood    String
  landmark        String?
  latitude        Float?
  longitude       Float?

  whatsappNumber  String?
  openingHours    Json?

  isVerifiedBadge Boolean                @default(false)
  isVisible       Boolean                @default(true)
  deliveryAvailable Boolean              @default(false)

  // CR-002: Réseau & Cycle de vie
  verificationLevel   VerificationLevel   @default(FULLY_VERIFIED)
  claimStatus         ClaimStatus         @default(CLAIMED)
  source              String?             // e.g. "MY_MAPS_IMPORT", "MANUAL", "KYC_ONBOARDING"
  sourceRef           String?             // e.g. "kml_pm_1_..."
  fieldLocks          Json?               // liste des champs protégés contre écrasement réimport
  onlineOrderingEnabled Boolean           @default(true) // false pour points LISTED non revendiqués

  importBatchId       String?
  importBatch         ImportBatch?        @relation(fields: [importBatchId], references: [id])

  reliabilityScore Float                 @default(100)
  badges          Json?

  // Numéros réels de réception des règlements MoMo
  momoReceiverNumber   String?
  momoAccountName      String?
  orangeReceiverNumber String?
  orangeAccountName    String?
  acceptCash           Boolean                @default(true)

  inventories     Inventory[]
  orders          Order[]
  stockReservations StockReservation[]
  reports         Report[]
  claims          StoreClaim[]
  importRecords   ImportRecord[]
  counterSales    CounterSale[]
  favorites       Favorite[]
  stockAlerts     StockAlert[]

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([source, sourceRef])
}

model ImportBatch {
  id                   String         @id @default(uuid())
  fileName             String
  fileHashSha256       String
  status               String         @default("STAGED") // STAGED, DRY_RUN_COMPLETED, PENDING_APPROVAL, APPROVED, APPLIED, REJECTED, ROLLED_BACK
  totalPlacemarks      Int            @default(0)
  importedCount        Int            @default(0)
  quarantinedCount     Int            @default(0)
  rawSummary           Json?
  pleingazAgreementRef String?
  createdById          String?
  createdBy            User?          @relation("ImportBatchCreatedBy", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           User?          @relation("ImportBatchApprovedBy", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  appliedAt            DateTime?
  rolledBackAt         DateTime?

  stores               Store[]
  records              ImportRecord[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model ImportRecord {
  id               String       @id @default(uuid())
  batchId          String
  batch            ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  storeId          String?
  store            Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  sourceRef        String
  rawName          String
  rawDescription   String?
  rawCoordinates   String
  classifiedType   String
  status           String       @default("STAGED") // STAGED, VALIDATED, QUARANTINE_INDIVIDUAL, QUARANTINE_DUPLICATE, QUARANTINE_INVALID_GEO, IMPORTED, IGNORED
  quarantineReason String?
  rawPayload       Json?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([batchId, status])
}

model StoreClaim {
  id              String       @id @default(uuid())
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation("ClaimSubmittedBy", fields: [userId], references: [id], onDelete: Cascade)

  status          String       @default("SUBMITTED") // SUBMITTED, PHONE_OTP_PENDING, PHONE_OTP_VERIFIED, UNDER_ADMIN_REVIEW, APPROVED, REJECTED, CANCELLED
  applicantPhone  String
  otpHash         String?
  otpExpiresAt    DateTime?
  otpVerifiedAt   DateTime?

  reviewedById    String?
  reviewedBy      User?        @relation("ClaimReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNotes     String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([storeId, status])
}


// ==========================================
// 3. CATALOGUE EXCLUSIF PLEINGAZ (D-01)
// ==========================================

model ProductCategory {
  id           String    @id @default(uuid())
  name         String    @unique // "Bouteilles", "Accessoires"
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  products     Product[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id              String          @id @default(uuid())
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  name            String          // Libellé officiel PLEINGAZ
  sku             String          @unique // ex: PG-BOT-125, PG-ACC-DET
  description     String?
  weightKg        Float           // ex: 12.5, 6, 0 (accessoires)
  imageUrl        String?
  isActive        Boolean         @default(true)

  prices          ProductPrice[]
  priceHistories  PriceHistory[]
  inventories     Inventory[]
  demandAlerts    DemandAlert[]
  orderItems      OrderItem[]
  stockReservations StockReservation[]
  favorites       Favorite[]
  stockAlerts     StockAlert[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum PriceStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXPIRED
}

model ProductPrice {
  id               String      @id @default(uuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  publicPrice      Int         // FCFA entier (pas de décimales)
  distributorPrice Int         // FCFA entier
  effectiveFrom    DateTime    @default(now())
  effectiveTo      DateTime?
  status           PriceStatus @default(PROPOSED)

  createdById      String
  createdBy        User        @relation("PriceCreatedBy", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?       @relation("PriceApprovedBy", fields: [approvedById], references: [id])

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model PriceHistory {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPublicPrice      Int
  newPublicPrice      Int
  oldDistributorPrice Int
  newDistributorPrice Int
  changeReason        String?
  changedAt           DateTime @default(now())
  changedByUserId     String?
  changedByUser       User?    @relation("PriceHistoryChangedBy", fields: [changedByUserId], references: [id])
}

// Déclaration qualitative stricte de stock (BON / MOYEN / FAIBLE / RUPTURE)
enum StockLevel {
  BON
  MOYEN
  FAIBLE
  RUPTURE
}

model Inventory {
  id               String     @id @default(uuid())
  storeId          String
  store            Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  level            StockLevel @default(RUPTURE)
  lastConfirmedAt  DateTime   @default(now())

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([storeId, productId])
}

// D-02: Recherche et protection de la vie privée (zone grossière, zéro coordonnées fines stockées)
model SearchEvent {
  id            String   @id @default(uuid())
  userId        String?
  coarseArea    String?  // Ville ou quartier
  productId     String?
  resultsCount  Int

  createdAt     DateTime @default(now())
}

model DemandAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  city        String?
  neighborhood String?
  storeId     String?

  isFulfilled Boolean   @default(false)
  fulfilledAt DateTime?

  createdAt   DateTime  @default(now())
}

// ==========================================
// 4. LOGISTIQUE & LIVREURS (D-05)
// ==========================================

enum VehicleType {
  MOTO
  VELO
  VOITURE
  PIED
}

enum CourierStatus {
  PENDING
  APPROVED
  SUSPENDED
  INACTIVE
  REJECTED
}

model Courier {
  id              String              @id @default(uuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType     VehicleType         @default(MOTO)
  status          CourierStatus       @default(PENDING)
  cashBalance     Int                 @default(0) // Solde d'espèces cumulé en FCFA

  availability    CourierAvailability?
  zones           CourierZone[]
  assignments     DeliveryAssignment[]
  deliveries      Delivery[]          @relation("CourierDeliveries")
  cashCollections CashCollection[]
  payouts         CourierPayout[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CourierAvailability {
  id          String   @id @default(uuid())
  courierId   String   @unique
  courier     Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  isOnline    Boolean  @default(false)
  lastSeenAt  DateTime?
  currentLat  Float?
  currentLng  Float?

  updatedAt   DateTime @updatedAt
}

model CourierZone {
  id        String   @id @default(uuid())
  courierId String
  courier   Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  city      String
  areaName  String

  createdAt DateTime @default(now())
}

enum AssignmentStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}

model DeliveryAssignment {
  id         String           @id @default(uuid())
  deliveryId String
  delivery   Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courierId  String
  courier    Courier          @relation(fields: [courierId], references: [id], onDelete: Cascade)
  status     AssignmentStatus @default(PROPOSED)
  timeoutAt  DateTime

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

enum CashCollectionStatus {
  COLLECTED
  REMITTED_TO_PLEINGAZ
  DISPUTED
}

model CashCollection {
  id           String               @id @default(uuid())
  deliveryId   String
  delivery     Delivery             @relation(fields: [deliveryId], references: [id])
  courierId    String
  courier      Courier              @relation(fields: [courierId], references: [id])
  amount       Int                  // FCFA entier
  status       CashCollectionStatus @default(COLLECTED)
  remittedAt   DateTime?

  reconciledById String?
  reconciledBy User?                @relation("CashReconciledBy", fields: [reconciledById], references: [id])

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

enum FeeScheduleStatus {
  PROPOSED
  APPROVED
  EXPIRED
}

model FeeSchedule {
  id                  String            @id @default(uuid())
  areaId              String?
  deliveryFeeCustomer Int               // FCFA
  courierPayout       Int               // FCFA
  pleingazMargin      Int               // FCFA
  effectiveFrom       DateTime          @default(now())
  effectiveTo         DateTime?
  status              FeeScheduleStatus @default(PROPOSED)

  createdById         String
  createdBy           User              @relation("FeeCreatedBy", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?             @relation("FeeApprovedBy", fields: [approvedById], references: [id])

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

enum CourierPayoutStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model CourierPayout {
  id                    String              @id @default(uuid())
  courierId             String
  courier               Courier             @relation(fields: [courierId], references: [id])
  payoutBatchId         String?
  payoutBatch           PayoutBatch?        @relation(fields: [payoutBatchId], references: [id])
  grossDeliveriesAmount Int                 // FCFA
  cashDeductionAmount   Int                 // FCFA
  netPayoutAmount       Int                 // FCFA
  status                CourierPayoutStatus @default(PENDING)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// ==========================================
// 5. COMMANDES & LIVRAISONS
// ==========================================

enum OrderType {
  B2C_PICKUP
  B2C_DELIVERY
  B2B_DISTRIBUTOR
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  type            OrderType
  status          OrderStatus @default(DRAFT)

  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])

  storeId         String?
  store           Store?      @relation(fields: [storeId], references: [id])

  totalAmount     Int         // FCFA entier

  // Livraison
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryNotes   String?
  deliverySlot    DateTime?

  assistedById    String?
  assistedBy      User?       @relation("AssistedOrders", fields: [assistedById], references: [id])

  items           OrderItem[]
  reservations    StockReservation[]
  payments        Payment[]
  delivery        Delivery?
  invoice         Invoice?
  review          Review?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Int      // FCFA entier
  totalPrice Int      // FCFA entier
}

model StockReservation {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int

  expiresAt  DateTime
  isConsumed Boolean  @default(false)

  createdAt  DateTime @default(now())
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED_PENDING_CONFIRMATION
  DELIVERED
  CONFIRMED_BY_COURIER_ONLY
  DISPUTED
  FAILED
  CANCELLED
}

model Delivery {
  id                   String               @id @default(uuid())
  orderId              String               @unique
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courierId            String?
  courier              Courier?             @relation("CourierDeliveries", fields: [courierId], references: [id])

  status               DeliveryStatus       @default(PENDING)
  confirmationCodeHash String?              // SHA-256 du code client 4-6 chiffres

  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  courierConfirmedAt   DateTime?            // D-17: Horodatage quand le livreur clique "J'ai livré"
  customerConfirmedAt  DateTime?            // D-17: Horodatage quand le client confirme "J'ai reçu"
  disputedAt           DateTime?            // D-17: Horodatage en cas de contestation client
  disputeReason        String?              // Motif du litige client
  failedReason         String?

  assignments          DeliveryAssignment[]
  cashCollections      CashCollection[]

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

// ==========================================
// 6. FINANCES, GRAND LIVRE & FACTURATION (D-06)
// ==========================================

model Invoice {
  id            String       @id @default(uuid())
  invoiceNumber String       @unique
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id])

  sellerName    String
  totalAmount   Int          // FCFA entier
  pdfUrl        String?

  isVoided      Boolean      @default(false)
  creditNotes   CreditNote[]

  createdAt     DateTime     @default(now())
}

model CreditNote {
  id               String   @id @default(uuid())
  creditNoteNumber String   @unique
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  amount           Int      // FCFA entier
  reason           String

  createdById      String
  createdBy        User     @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])

  createdAt        DateTime @default(now())
}

enum PaymentMethod {
  CASH
  MTN_MOMO
  ORANGE_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])

  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  amount          Int           // FCFA entier
  fee             Int           @default(0) // FCFA entier

  idempotencyKey  String        @unique
  providerTxId    String?       @unique

  customerTxRef   String?       // Référence SMS/transfert renseignée par le client
  confirmedByUserId String?     // ID du gérant/distributeur ayant vérifié et confirmé les fonds
  confirmedAt     DateTime?     // Date/heure exacte de confirmation par le titulaire du compte

  lastWebhookData Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// Plan de comptes (1010, 1020, 1030, 4010, 4020, 7010, 7020, 6010, 6020)
model LedgerAccount {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  type        AccountType
  description String?
  entries     LedgerEntry[]

  createdAt   DateTime      @default(now())
}

// Grand livre immuable à écriture double (Insert-Only : JAMAIS d'update ni delete)
model LedgerEntry {
  id             String        @id @default(uuid())
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  transactionRef String        // Rapprochement équilibré débit == crédit
  debit          Int           @default(0) // FCFA
  credit         Int           @default(0) // FCFA
  description    String
  entityType     String?       // "ORDER", "PAYOUT", "CASH_COLLECTION", "REFUND"
  entityId       String?

  createdById    String?
  createdBy      User?         @relation("LedgerEntryCreatedBy", fields: [createdById], references: [id])

  createdAt      DateTime      @default(now())
}

enum BeneficiaryType {
  DISTRIBUTOR
  COURIER
}

enum BatchStatus {
  PROPOSED
  APPROVED
  EXECUTED
  CANCELLED
}

model PayoutBatch {
  id                  String          @id @default(uuid())
  batchNumber         String          @unique
  beneficiaryType     BeneficiaryType
  totalAmount         Int             // FCFA
  status              BatchStatus     @default(PROPOSED)

  createdById         String
  createdBy           User            @relation("PayoutCreatedBy", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?           @relation("PayoutApprovedBy", fields: [approvedById], references: [id])
  secondApprovedById  String?         // Double validation au-delà du seuil paramétré
  secondApprovedBy    User?           @relation("PayoutSecondApprovedBy", fields: [secondApprovedById], references: [id])

  operatorTxRef       String?
  proofFileUrl        String?
  executedAt          DateTime?

  courierPayouts      CourierPayout[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

// ==========================================
// 7. PARAMÈTRES & SUPPORT
// ==========================================

model PlatformSettings {
  id                              String   @id @default("singleton")
  adminMomoNumber                 String?
  adminOrangeNumber               String?

  searchDefaultRadiusKm           Int      @default(5)
  searchGpsTimeoutSeconds         Int      @default(8)
  maxCashHoldingCourier           Int      @default(50000)   // Défaut appliqué illustratif
  payoutDoubleApprovalThreshold   Int      @default(500000)  // Défaut appliqué illustratif
  maxUploadSizeBytes              Int      @default(5242880) // 5 Mo

  supportPhone                    String   @default("+237 657696567")
  supportEmail                    String   @default("donfackdurel1980@icloud.com")

  // --- New fields for pricing & limits (CR‑003) ---
  buyerBottleLimit                Int      @default(5)          // Max bouteilles achetées par un client
  deliveryFixedPrice              Int      @default(2000)       // Prix fixe de livraison (FCFA)
  priceGasPerLitre                Int      @default(850)        // Prix du gaz par litre (FCFA)
  priceBottlePerLitre             Int      @default(2500)       // Prix d'une bouteille de 12,5 kg (FCFA)

  updatedAt                       DateTime @updatedAt
}

// ==========================================
// 8. NOTIFICATIONS & CHAT
// ==========================================

enum NotificationType {
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  status    NotificationStatus @default(PENDING)

  title     String
  content   String
  metadata  Json?

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum ReportReason {
  OUT_OF_STOCK
  STORE_CLOSED
  WRONG_NUMBER
  WRONG_PRICE
  OTHER
}

model Report {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id])

  reason     ReportReason
  details    String?

  isResolved Boolean      @default(false)

  createdAt  DateTime     @default(now())
}

model ChatConversation {
  id             String        @id @default(uuid())
  participant1Id String
  participant2Id String

  messages       ChatMessage[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([participant1Id, participant2Id])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User             @relation("SentMessages", fields: [senderId], references: [id])

  content        String
  attachmentUrl  String?
  isRead         Boolean          @default(false)

  createdAt      DateTime         @default(now())
}

// ==========================================
// 9. IA, ANALYTIQUES & REVIEWS
// ==========================================

model KnowledgeDocument {
  id        String   @id @default(uuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  version   Int      @default(1)

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  history   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsageMetric {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)

  createdAt        DateTime @default(now())
}

model HeatmapEvent {
  id        String           @id @default(uuid())
  type      HeatmapEventType
  latitude  Float
  longitude Float
  gridId    String
  metadata  Json?
  createdAt DateTime         @default(now())
}

enum HeatmapEventType {
  DEMAND
  NO_RESULT
  OUT_OF_STOCK
}

model Review {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])

  rating      Int
  comment     String?
  isModerated Boolean  @default(false)

  createdAt   DateTime @default(now())
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  points      Int
  description String
  createdAt   DateTime @default(now())
}

// ==========================================
// 10. MODÈLES CR-003 (D-11 à D-18)
// ==========================================

model VerificationChallenge {
  id              String           @id @default(uuid())
  phone           String           // E.164
  expected_e164   String?          @map("expected_e164") // E.164 attendu
  codeHash        String           @map("code_hash")     // Argon2id
  purpose         String           @default("LOGIN")     // LOGIN, REGISTER, PHONE_CHANGE
  channel         String           @default("WHATSAPP")  // WHATSAPP, SMS_BACKUP
  ipAddress       String?          @map("ip_address")
  attempts        Int              @default(0)
  expiresAt       DateTime         @map("expires_at")
  verifiedAt      DateTime?        @map("verified_at")
  consumedAt      DateTime?        @map("consumed_at")
  sessionBinding  String?          @map("session_binding")
  createdAt       DateTime         @default(now()) @map("created_at")

  userId          String?          @map("user_id")
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([expected_e164, expiresAt])
}

model AccountCase {
  id              String           @id @default(uuid())
  caseNumber      String           @unique
  status          String           @default("OPEN") // OPEN, PROPOSED, ADMIN_APPROVED, APPLIED, REJECTED, CLOSED
  reason          String           // Motif formel obligatoire D-15
  proposedAction  String           // JSON ou description structurée
  evidenceUrls    String[]         // Pièces justificatives
  
  agentId         String           // Gestionnaire de compte (ACCOUNT_MANAGER)
  agent           User             @relation("ManagedAccountCases", fields: [agentId], references: [id])
  
  targetUserId    String           // Usager concerné
  targetUser      User             @relation("SubjectAccountCases", fields: [targetUserId], references: [id])
  
  approvedById    String?          // Rôle ADMIN
  adminNotes      String?
  appliedAt       DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, agentId])
  @@index([targetUserId])
}

model CounterSale {
  id              String           @id @default(uuid())
  receiptNumber   String           @unique
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  
  sellerId        String           // DISTRIBUTOR_MANAGER ou STAFF
  
  customerPhone   String           // E.164
  customerUserId  String?
  customerUser    User?            @relation("CounterSaleCustomer", fields: [customerUserId], references: [id])
  
  bottleType      String           // ex: Tradex 12.5 kg
  quantity        Int              @default(1)
  amountTotal     Int              // FCFA
  paymentMethod   String           @default("CASH") // CASH, MOMO
  
  quotaValidated  Boolean          @default(true)
  ledgerEntryId   String?
  
  createdAt       DateTime         @default(now())

  @@index([storeId, createdAt])
  @@index([customerPhone])
}

model InfoNotice {
  id              String           @id @default(uuid())
  title           String
  content         String
  category        String           @default("INFO") // INFO, WARNING, CRITICAL
  targetRole      String?          // CUSTOMER, DISTRIBUTOR, COURIER, ALL
  targetCity      String?          // Douala, Yaoundé, ALL
  isActive        Boolean          @default(true)
  requiresAck     Boolean          @default(true)
  startsAt        DateTime         @default(now())
  expiresAt       DateTime?
  
  createdById     String
  approvedById    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reads           InfoNoticeRead[]
}

model InfoNoticeRead {
  id              String           @id @default(uuid())
  noticeId        String
  notice          InfoNotice       @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt          DateTime         @default(now())

  @@unique([noticeId, userId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?  @map("store_id")
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, storeId, productId])
  @@map("favorites")
}

model StockAlert {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId     String?   @map("store_id")
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isTriggered Boolean   @default(false) @map("is_triggered")
  triggeredAt DateTime? @map("triggered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("stock_alerts")
}

model Announcement {
  id          String                 @id @default(uuid())
  title       String
  content     String
  category    String                 @default("INFO") // INFO, WARNING, CRITICAL
  isActive    Boolean                @default(true) @map("is_active")
  requiresAck Boolean                @default(true) @map("requires_ack")
  startsAt    DateTime               @default(now()) @map("starts_at")
  expiresAt   DateTime?              @map("expires_at")
  createdById String                 @map("created_by_id")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  audiences   AnnouncementAudience[]
  receipts    AnnouncementReceipt[]

  @@map("announcements")
}

model AnnouncementAudience {
  id             String         @id @default(uuid())
  announcementId String         @map("announcement_id")
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  targetSpace    String?        @map("target_space") // CUSTOMER, DISTRIBUTOR, COURIER, ALL
  targetCity     String?        @map("target_city")  // Douala, Yaoundé, ALL
  groupId        String?        @map("group_id")
  group          AudienceGroup? @relation(fields: [groupId], references: [id])

  @@map("announcement_audiences")
}

model AudienceGroup {
  id          String                 @id @default(uuid())
  name        String                 @unique
  description String?
  audiences   AnnouncementAudience[]

  @@map("audience_groups")
}

model AnnouncementReceipt {
  id             String       @id @default(uuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([announcementId, userId])
  @@map("announcement_receipts")
}


