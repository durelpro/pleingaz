generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, unaccent]
}

model User {
  id              String           @id @default(uuid())
  phone           String           @unique
  email           String?          @unique
  passwordHash    String?          // Argon2id hash
  isPhoneVerified Boolean          @default(false)
  isEmailVerified Boolean          @default(false)
  failedAttempts  Int              @default(0)
  lockedUntil     DateTime?
  roles           UserRole[]
  customerProfile CustomerProfile?
  distributorApp  DistributorApplication?
  stores          Store[]
  sessions        Session[]
  auditLogs       AuditLog[]       @relation("UserAuditLogs")
  demandAlerts    DemandAlert[]
  
  customerOrders  Order[]          @relation("CustomerOrders")
  assistedOrders  Order[]          @relation("AssistedOrders")
  driverDeliveries Delivery[]      @relation("DriverDeliveries")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. ADMIN, DISTRIBUTOR, CUSTOMER
  description String?
  permissions RolePermission[]
  users       UserRole[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // e.g. "orders:read", "stores:write"
  description String?
  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model CustomerProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  firstName String?
  lastName  String?
  addresses Address[]

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id                String          @id @default(uuid())
  customerProfileId String
  city              String
  neighborhood      String
  landmark          String?         // Repère textuel (ex: "en face de la boulangerie")
  latitude          Float?
  longitude         Float?
  isDefault         Boolean         @default(false)

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique // Hash of the refresh token
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?

  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  CNI_FRONT
  CNI_BACK
  REGISTRE_COMMERCE
  PLAN_LOCALISATION
  PHOTO_BOUTIQUE
}

model DistributorApplication {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(DRAFT)
  currentStep     Int               @default(1) // Pour la reprise du wizard
  
  businessName    String?
  taxId           String?
  
  city            String?
  neighborhood    String?
  landmark        String?
  latitude        Float?
  longitude       Float?
  whatsappNumber  String?
  
  documents       StoreDocument[]
  
  rejectionReason String?
  verifiedAt      DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  store           Store?
}

model StoreDocument {
  id             String                 @id @default(uuid())
  applicationId  String
  application    DistributorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           DocumentType
  fileUrl        String                 // Chemin ou URI privé
  isValid        Boolean?
  rejectedReason String?
  
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model Store {
  id              String                 @id @default(uuid())
  applicationId   String                 @unique
  application     DistributorApplication @relation(fields: [applicationId], references: [id])
  ownerId         String
  owner           User                   @relation(fields: [ownerId], references: [id])
  
  name            String
  city            String
  neighborhood    String
  landmark        String?
  latitude        Float?
  longitude       Float?
  
  whatsappNumber  String?
  openingHours    Json?                  // ex: { monday: "08:00-18:00" }
  
  isVerifiedBadge Boolean                @default(true)
  isVisible       Boolean                @default(true)
  
  // Paiements (Numéros de réception des fonds du distributeur)
  momoReceiverNumber   String?
  orangeReceiverNumber String?
  
  inventories     Inventory[]
  orders          Order[]
  stockReservations StockReservation[]
  
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

// ==========================================
// PHASE 4: PRODUITS, STOCKS & RECHERCHE
// ==========================================

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String          @id @default(uuid())
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  brand           String          // ex: SCTM, Camgaz, Tradex, BOCOM, OLA, GreenOil
  weightKg        Float           // ex: 12.5, 6, 50
  publicPrice     Float           // Prix public conseillé
  distributorPrice Float          // Prix distributeur
  promoPrice      Float?          // Prix promotionnel éventuel
  
  inventories     Inventory[]
  priceHistories  PriceHistory[]
  demandAlerts    DemandAlert[]
  orderItems      OrderItem[]
  stockReservations StockReservation[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([brand, weightKg])
}

model PriceHistory {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPublicPrice   Float
  newPublicPrice   Float
  oldDistributorPrice Float
  newDistributorPrice Float
  changedByUserId  String?  // Admin ID
  
  createdAt        DateTime @default(now())
}

enum StockLevel {
  HIGH
  MEDIUM
  LOW
  OUT_OF_STOCK
}

model Inventory {
  id               String     @id @default(uuid())
  storeId          String
  store            Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  level            StockLevel @default(OUT_OF_STOCK)
  lastConfirmedAt  DateTime   @default(now()) // Pour le calcul d'ancienneté (Vert/Orange/Rouge/Gris)
  
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([storeId, productId])
}

model SearchEvent {
  id            String   @id @default(uuid())
  userId        String?
  searchQuery   String?  // Terme recherché (ex: quartier)
  latitude      Float?
  longitude     Float?
  radiusKm      Float?
  resultsCount  Int
  
  createdAt     DateTime @default(now())
}

model DemandAlert {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  latitude    Float?
  longitude   Float?
  radiusKm    Float?
  storeId     String?  // Si alerte sur une boutique spécifique
  
  isFulfilled Boolean  @default(false)
  fulfilledAt DateTime?
  
  createdAt   DateTime @default(now())
}

// ==========================================
// PHASE 5: COMMANDES & LIVRAISONS
// ==========================================

enum OrderType {
  B2C_PICKUP
  B2C_DELIVERY
  B2B_DISTRIBUTOR // Commande distributeur vers PLEINGAZ
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique // Généré: ORD-20261006-XXXX
  type            OrderType
  status          OrderStatus @default(DRAFT)
  
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  
  storeId         String?     // Nullable si B2B direct ou avant choix du store
  store           Store?      @relation(fields: [storeId], references: [id])
  
  totalAmount     Float
  
  // Livraison
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryNotes   String?
  deliverySlot    DateTime?
  
  // Assistance (Tâche 5.7)
  assistedById    String?
  assistedBy      User?       @relation("AssistedOrders", fields: [assistedById], references: [id])
  
  items           OrderItem[]
  reservations    StockReservation[]
  payments        Payment[]
  delivery        Delivery?
  invoice         Invoice?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model StockReservation {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  
  expiresAt   DateTime // Expiration stricte (ex: +15 minutes)
  isConsumed  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model Delivery {
  id              String         @id @default(uuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  driverId        String?
  driver          User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  
  status          DeliveryStatus @default(PENDING)
  confirmationOtp String?        // Code OTP à remettre au client (Tâche 5.4)
  
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  failedReason    String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique // Numérotation unique par vendeur
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  
  sellerName    String   // "PLEINGAZ - Vente directe" ou "Distributeur agréé : X"
  totalAmount   Float
  pdfUrl        String?  // Facture immuable PDF
  
  isVoided      Boolean  @default(false) // Pour gestion des avoirs
  
  createdAt     DateTime @default(now())
}

// ==========================================
// PHASE 6: PAIEMENTS & WALLETS
// ==========================================

enum PaymentMethod {
  CASH
  MTN_MOMO
  ORANGE_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  
  amount          Float
  fee             Float         @default(0) // Frais de transaction
  
  // Idempotence & Fournisseur
  idempotencyKey  String        @unique // Empêcher les doublons
  providerTxId    String?       @unique // ID de transaction renvoyé par MTN/Orange
  
  // Webhooks
  lastWebhookData Json?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PlatformSettings {
  id                   String   @id @default("singleton")
  adminMomoNumber      String?
  adminOrangeNumber    String?
  
  updatedAt            DateTime @updatedAt
}
